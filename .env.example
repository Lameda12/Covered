# Local dev reads this file (copy to .env.local and .dev.vars). In production EVERY server value below is a
# Worker secret:  pnpm wrangler secret put NAME   (see README). NEXT_PUBLIC_* are inlined at build time,
# so they must be present when `pnpm deploy` runs (put them in .env.production), not as secrets.

# --- Supabase: Auth only (magic links, sessions). Project Settings > API ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used solely for Auth admin calls (generateLink, getUserById). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Database: Cloudflare Hyperdrive binding `HYPERDRIVE` (wrangler.jsonc) in production ---
# Local/scripts fallback only. Use the least-privilege `covered_app` role, never `postgres`.
DATABASE_URL=postgres://covered_app:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Anthropic: reads bill photos and parses sweep sentences ---
ANTHROPIC_API_KEY=

# --- Resend. If RESEND_API_KEY is unset, emails are logged instead of sent ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Cloudflare R2 (private bucket `covered-bills`), S3 API token with Object Read & Write on that bucket ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=covered-bills

# --- Cloudflare Turnstile. Dev test keys that always pass: site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- App ---
# No trailing slash. Your workers.dev (or custom) URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Random string. The Cron Trigger sends it as `Authorization: Bearer $CRON_SECRET` to /api/cron/expire.
CRON_SECRET=

# --- Tests only ---
# TEST_DATABASE_URL=postgres://postgres@localhost:54329/covered_test
