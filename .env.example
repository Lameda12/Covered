# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (Developers > API keys / Webhooks) ---
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen` locally, or the endpoint's signing secret in production.
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Anthropic: reads bill photos and parses sweep sentences ---
ANTHROPIC_API_KEY=

# --- Resend: transactional email. If unset, emails are logged to the server console ---
RESEND_API_KEY=
# Verified sender, e.g. "Covered <hello@yourdomain.com>". Defaults to Resend's sandbox sender.
EMAIL_FROM=

# --- App ---
# No trailing slash. http://localhost:3000 locally, your Vercel URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Random string. Vercel Cron sends it as `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=

# --- Tests only (local Postgres; see README) ---
# TEST_DATABASE_URL=postgres://postgres@localhost:54329/covered_test
